android_filesystem {
    name: "cuttlefish_example_custom",

    mount_point: "/cuttlefish_example_custom",
    partition_size: 1048576, // 1 MB
    type: "ext4",

    dists: [
        {
            targets: [
                "droidcore",
                "droidcore-unbundled",
            ],
        },
    ],
}

android_filesystem {
    name: "userdata_exp.super",

    mount_point: "/userdata_exp.super",
    partition_size: 4294967296, // 4 GB
    type: "f2fs",

    dists: [
        {
            targets: [
                "droidcore",
                "droidcore-unbundled",
            ],
        },
    ],
}
